---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickQuote from '../components/QuickQuote.astro';
import {districts,services} from '../data/site';
import {neighborhoods} from '../data/neighborhoods';
---
<Base title="부산폐기물 | 부산건설폐기물·인테리어철거·공사폐기물 수거 상담" description="부산폐기물 전문 상담. 부산건설폐기물, 인테리어폐기물, 철거잔재, 상가·사무실·창고 혼합폐기물. 부산진구·해운대구·사상구·강서구 등 부산 16개 구·군 수거 상담.">
<Header/>
<main id="main-content" tabindex="-1">
<section class="hero" aria-label="부산폐기물 소개">
<div class="hero-slide active" style="--hero-img:url('https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1800&q=85')"></div>
<div class="hero-slide" style="--hero-img:url('https://images.unsplash.com/photo-1581094794329-c8112a89af12?auto=format&fit=crop&w=1800&q=85')"></div>
<div class="hero-slide" style="--hero-img:url('https://images.unsplash.com/photo-1487958449943-2429e8be8625?auto=format&fit=crop&w=1800&q=85')"></div>
<div class="hero-overlay"></div><div class="hero-truck-visual" aria-hidden="true"><img src="/images/hero-truck.svg" alt="" width="1050" height="650" /></div><div class="wrap hero-content"><span class="eyebrow light">🚛 부산 전지역 · 건설·인테리어 폐기물</span><p class="hero-kicker">부산 현장별 폐기물 수거 상담</p><h1>부산폐기물<br/><em>현장에 맞는 수거 솔루션</em></h1><p class="hero-desc">건설폐기물 · 인테리어철거 · 공사 잔재물 · 상가폐기물까지<br/>부산 전지역 현장 여건에 맞춰 신속하게 상담합니다.</p><div class="hero-ctas"><a class="btn btn-blue" href="tel:01066484886">📞 전화상담 010-6648-4886</a><a class="btn btn-yellow" href="http://qr.kakao.com/talk/xiB5oLU91AZmWwLV9g5AwwM4O5I-">💬 카카오톡 견적상담</a></div><div class="hero-points"><span>🚛 현장별 차량 상담</span><span>🧤 철거 잔재물 상담</span><span>📷 사진으로 간편 문의</span><span>📍 부산 16개 구·군</span></div></div><button class="slide-arrow prev" aria-label="이전 슬라이드">‹</button><button class="slide-arrow next" aria-label="다음 슬라이드">›</button><div class="slide-count"><span id="slide-index">01</span> / 03</div><div class="slide-dots" aria-label="슬라이드 선택"><button class="active" data-slide="0" aria-pressed="true" aria-label="첫 번째 슬라이드"></button><button data-slide="1" aria-pressed="false" aria-label="두 번째 슬라이드"></button><button data-slide="2" aria-pressed="false" aria-label="세 번째 슬라이드"></button></div></section>
<section class="services-wrap wrap reveal" id="services"><div class="service-grid">{services.map(s=><a class="service-card" href={'/services/'+s.slug}><span class="service-emoji" aria-hidden="true"><img src={"/images/icons/"+s.slug+".svg"} width="90" height="90" loading="lazy" alt="" /></span><strong>{s.name}</strong><small>{s.sub}</small><span class="service-arrow">↗</span></a>)}</div></section>
<section class="section about-section" id="areas"><div class="wrap about-grid"><div class="reveal"><span class="eyebrow">BUSAN WASTE COLLECTION</span><h2>부산 16개 구·군<br/><span>현장 조건부터 확인합니다</span></h2><p>부산 16개 구·군, 건설·인테리어·상가·사업장 폐기물까지. 지역과 작업 환경에 맞는 수거 방법을 안내합니다.</p><div class="region-search"><label for="region-query">🔎 부산 구·동 빠른 검색</label><input id="region-query" type="search" autocomplete="off" placeholder="예: 부산진구, 개금동, 해운대구" aria-controls="region-results" aria-expanded="false"/><div id="region-results" class="region-results" aria-live="polite" hidden></div></div><div class="district-grid">{districts.map(d=><a href={'/busan/'+encodeURIComponent(d)}>📍 {d}<span>↗</span></a>)}</div><div id="region-index" hidden>{Object.entries(neighborhoods).flatMap(([district,names])=>names.map(name=><a href={'/busan/'+encodeURIComponent(district)+'/'+encodeURIComponent(name)}>{district} {name} 폐기물수거</a>))}</div><a class="btn btn-blue area-btn" href="#quick-quote">우리 지역 수거 문의 →</a></div><div class="about-visual reveal"><div class="busan-graphic"><span class="pin pin-one">📍</span><span class="pin pin-two">📍</span><span class="pin pin-three">📍</span><strong>BUSAN</strong><small>16개 구·군 지역별 수거 상담</small></div><div class="floating-tag">🚚 부산 지역별 폐기물 수거</div></div></div></section>
<section class="section process-section"><div class="wrap"><div class="section-head reveal"><span class="eyebrow">HOW IT WORKS</span><h2>폐기물 상담부터 <span>4단계</span>로 진행합니다</h2><p>현장 사진과 위치를 알려주시면 작업 가능 여부와 진행 절차를 안내합니다.</p></div><div class="process-grid">{[{i:'📞',n:'01',t:'상담문의',d:'전화·카톡으로 현장 문의'},{i:'👷',n:'02',t:'현장확인',d:'품목·물량·반출 조건 확인'},{i:'📋',n:'03',t:'견적안내',d:'작업 범위 및 비용 안내'},{i:'🚛',n:'04',t:'수거 및 처리',d:'일정 협의 후 적법하게 진행'}].map((x,i)=><div class="process-card reveal" style={'transition-delay:'+(i*90)+'ms'}><span class="process-emoji">{x.i}</span><b>{x.n}</b><strong>{x.t}</strong><p>{x.d}</p></div>)}</div></div></section>
<section class="section works-section" id="works"><div class="wrap"><div class="section-head light reveal"><span class="eyebrow light">OUR WORK</span><h2>현장에 맞는 <span>폐기물 수거</span></h2><p>실제 작업 사진이 준비되면 현장별 전후 사례를 등록할 예정입니다.</p></div><div class="gallery-tools"><span>좌우로 넘겨 현장 유형을 살펴보세요</span><div><button type="button" class="gallery-prev" aria-label="이전 작업 유형">←</button><button type="button" class="gallery-next" aria-label="다음 작업 유형">→</button></div></div><div class="work-grid" id="work-gallery">{[{t:'인테리어 철거 잔재',s:'석고보드·목재·철거 잔재',img:'photo-1504307651254-35680f356dfd'},{t:'상가·매장 정리',s:'집기·가구·폐업 정리',img:'photo-1497366754035-f200968a6e72'},{t:'건설현장 폐기물',s:'공사 잔재·혼합폐기물',img:'photo-1487958449943-2429e8be8625'},{t:'창고·사업장 정리',s:'적치물·불용품 반출',img:'photo-1581094794329-c8112a89af12'}].map(x=><div class="work-card reveal"><img loading="lazy" src={'https://images.unsplash.com/'+x.img+'?auto=format&fit=crop&w=800&q=80'} alt={x.t+' 관련 참고 이미지'}/><div><strong>{x.t}</strong><small>{x.s}</small><span>참고 이미지</span></div></div>)}</div></div></section>
<section class="section equipment-section" id="equipment"><div class="wrap equipment-grid"><div class="reveal"><span class="eyebrow">EQUIPMENT & SERVICE</span><h2>현장 규모에 맞는<br/><span>차량·반출 방식 상담</span></h2><p>현장 접근로, 폐기물 종류와 물량에 따라 적합한 수거·운반 방식을 확인합니다. 차량 및 장비 투입 여부는 사전 상담 후 결정됩니다.</p><a class="btn btn-blue" href="#quick-quote">현장 조건 상담하기 →</a></div><div class="equipment-cards reveal"><div>🚚<strong>소량·중량별 수거</strong><small>물량과 품목 확인</small></div><div>🏗️<strong>집게차·대량 현장</strong><small>장비 진입 조건 확인</small></div><div>♻️<strong>분류·적법 처리</strong><small>품목별 처리 기준 확인</small></div></div></div></section>
<QuickQuote/>
<section class="section faq-section" id="faq"><div class="wrap faq-grid"><div class="reveal"><span class="eyebrow">FREQUENTLY ASKED QUESTIONS</span><h2>자주 묻는 질문</h2><p>궁금하신 내용을 확인해보세요.</p><a class="btn btn-outline" href="#quick-quote">견적 내용 준비하기 →</a></div><div class="faq-list reveal"><details><summary>견적은 어떻게 받나요?</summary><p>폐기물 사진, 위치(구·동), 대략적인 물량, 층수와 차량 진입 가능 여부를 알려주시면 상담이 원활합니다.</p></details><details><summary>어떤 폐기물까지 상담 가능한가요?</summary><p>건설·인테리어 잔재, 상가·사무실 집기, 창고 적치물 등을 상담합니다. 실제 수거 가능 여부는 폐기물의 법적 분류와 처리 조건에 따라 달라집니다.</p></details><details><summary>부산 전지역에서 문의할 수 있나요?</summary><p>부산 16개 구·군의 현장에 대해 문의하실 수 있습니다. 작업 가능 일정과 범위는 상담 시 확인합니다.</p></details><details><summary>현장 방문이 꼭 필요한가요?</summary><p>사진으로 1차 상담이 가능하지만 물량이나 반출 조건이 복잡한 현장은 추가 확인이 필요할 수 있습니다.</p></details></div></div></section>
<section class="contact-section" id="contact"><div class="wrap contact-inner reveal"><div><span>현장 정보를 정리해 간편하게 상담하세요</span><h2>현장 사진만 있어도 상담을 시작할 수 있습니다.</h2><p>부산 구·동, 폐기물 종류, 대략적인 물량을 알려주세요.</p></div><div class="contact-buttons"><a class="btn btn-white" href="tel:01066484886">📞 010-6648-4886</a><a class="btn btn-yellow" href="http://qr.kakao.com/talk/xiB5oLU91AZmWwLV9g5AwwM4O5I-">💬 카카오톡 견적상담</a></div></div></section>
</main><Footer/>
<script is:inline>
(()=>{const slides=[...document.querySelectorAll('.hero-slide')];let current=0;const counter=document.querySelector('#slide-index');function go(n){slides[current].classList.remove('active');current=(n+slides.length)%slides.length;slides[current].classList.add('active');counter.textContent=String(current+1).padStart(2,'0');document.querySelectorAll('[data-slide]').forEach((b,i)=>{b.classList.toggle('active',i===current);b.setAttribute('aria-pressed',String(i===current))})}document.querySelector('.slide-arrow.prev')?.addEventListener('click',()=>go(current-1));document.querySelector('.slide-arrow.next')?.addEventListener('click',()=>go(current+1));document.querySelectorAll('[data-slide]').forEach(b=>b.addEventListener('click',()=>go(Number(b.dataset.slide))));const hero=document.querySelector('.hero');const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');let timer;const stop=()=>{clearInterval(timer);timer=undefined};const start=()=>{stop();if(!reduced.matches&&!document.hidden)timer=setInterval(()=>go(current+1),6000)};hero?.addEventListener('mouseenter',stop);hero?.addEventListener('mouseleave',start);hero?.addEventListener('focusin',stop);hero?.addEventListener('focusout',e=>{if(!hero.contains(e.relatedTarget))start()});document.addEventListener('visibilitychange',()=>document.hidden?stop():start());reduced.addEventListener?.('change',start);start()})();
</script>
<script is:inline>
(()=>{const input=document.querySelector('#region-query');const results=document.querySelector('#region-results');if(input&&results){const entries=[...new Map([...document.querySelectorAll('#region-index a,#areas .district-grid a')].map(a=>[a.getAttribute('href'),{label:a.textContent.trim().replace('↗',''),href:a.getAttribute('href')}])).values()];const hideResults=()=>{results.hidden=true;input.setAttribute('aria-expanded','false')};input.addEventListener('keydown',e=>{if(e.key==='Escape'){hideResults()}else if(e.key==='ArrowDown'&&!results.hidden){const first=results.querySelector('a');if(first){e.preventDefault();first.focus()}}else if(e.key==='Enter'&&!results.hidden){const first=results.querySelector('a');if(first){e.preventDefault();location.assign(first.href)}}});results.addEventListener('keydown',e=>{if(e.key==='Escape'){hideResults();input.focus()}else if(e.key==='ArrowDown'||e.key==='ArrowUp'){const links=[...results.querySelectorAll('a')];const index=links.indexOf(document.activeElement);if(index!==-1){e.preventDefault();const next=index+(e.key==='ArrowDown'?1:-1);if(next<0)input.focus();else links[Math.min(next,links.length-1)].focus()}}});document.addEventListener('click',e=>{if(!input.contains(e.target)&&!results.contains(e.target))hideResults()});input.addEventListener('input',()=>{const q=input.value.trim().replace(/\s+/g,'');results.replaceChildren();if(!q){hideResults();return}const normalized=q.replace(/^부산(광역시)?/,'');if(!normalized){hideResults();return}const found=entries.filter(e=>{const parts=e.href.split('/').filter(Boolean).slice(1).map(p=>decodeURIComponent(p));return parts.some(p=>p.includes(normalized))}).sort((a,b)=>{const aName=a.label.replace(/\s+/g,'');const bName=b.label.replace(/\s+/g,'');const rank=(entry,name)=>{const parts=entry.href.split('/').filter(Boolean).slice(1).map(p=>decodeURIComponent(p));return parts.some(p=>p===normalized)?0:parts.some(p=>p.startsWith(normalized))?1:name.includes(normalized)?2:3};return rank(a,aName)-rank(b,bName)||aName.length-bName.length||aName.localeCompare(bName,'ko')}).slice(0,12);if(!found.length){const p=document.createElement('p');p.textContent='검색 결과가 없습니다. 구·동 이름을 다시 입력해 주세요.';results.append(p)}else{found.forEach(e=>{const a=document.createElement('a');a.href=e.href;a.textContent='📍 '+e.label;results.append(a)})}results.hidden=false;input.setAttribute('aria-expanded','true')})}const gallery=document.querySelector('#work-gallery');document.querySelector('.gallery-prev')?.addEventListener('click',()=>gallery?.scrollBy({left:-320,behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'}));document.querySelector('.gallery-next')?.addEventListener('click',()=>gallery?.scrollBy({left:320,behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'}));})();
</script>
</Base>
