---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {districts,services} from '../../data/site';
import {neighborhoods} from '../../data/neighborhoods';
import {districtGuides} from '../../data/districtGuides';
export function getStaticPaths(){return districts.map(d=>({params:{district:d},props:{district:d}}));}
const {district}=Astro.props;
const guide=districtGuides[district];
const focus=district==='강서구'?'창고·공장·사업장':district==='사상구'?'공장·상가·인테리어':district==='부산진구'?'상가·매장·인테리어':district==='해운대구'?'상가·리모델링·사무실':'건설·인테리어·상가';
---
<Base breadcrumbs={[{name:'부산 '+district,path:'/busan/'+encodeURIComponent(district)}]} title={'부산 '+district+' 폐기물수거 | '+focus+' 폐기물 상담 - 부산폐기물'} description={'부산 '+district+' 건설폐기물·인테리어폐기물·철거 잔재물 수거 상담. '+focus+' 현장의 물량과 반출 조건을 확인해 수거 가능 여부 및 견적을 안내합니다. 부산폐기물.'}>
<Header/><main><section class="sub-hero"><div class="wrap reveal in"><span class="eyebrow light">BUSAN · {district}</span><h1>부산 {district}<br/><em>폐기물수거 상담</em></h1><p>{focus} 폐기물부터 철거 잔재까지, 현장 상황을 확인해 수거 방법을 안내합니다.</p><div class="hero-ctas"><a class="btn btn-yellow" href="tel:01066484886">📞 전화 상담</a><a class="btn btn-white" href="http://qr.kakao.com/talk/xiB5oLU91AZmWwLV9g5AwwM4O5I-">💬 사진 견적 상담</a></div></div></section><section class="section"><div class="wrap"><div class="section-head"><span class="eyebrow">{district} WASTE SERVICES</span><h2>{district} 현장별 <span>폐기물 수거 안내</span></h2><p>폐기물의 종류와 현장 조건에 따라 반출 방식이 달라질 수 있습니다.</p></div><div class="service-grid regional-services">{services.map(s=><a class="service-card" href={'/services/'+s.slug}><span class="service-emoji"><img src={"/images/icons/"+s.slug+".svg"} width="90" height="90" loading="lazy" alt="" /></span><strong>{district} {s.name}</strong><small>{s.sub}</small><span class="service-arrow">↗</span></a>)}</div></div></section><section class="section about-section"><div class="wrap"><span class="eyebrow">LOCAL SERVICE GUIDE</span><h2>부산 {district} <span>수거 상담 시 확인사항</span></h2><p>현장 주소와 작업 층수, 엘리베이터 유무, 차량 접근 가능 여부, 폐기물 사진 및 예상 물량을 함께 알려주시면 보다 정확한 상담이 가능합니다. 건설폐기물과 사업장폐기물은 관련 법령에 따른 분류 및 처리 요건을 확인해야 합니다.</p><div class="local-guide"><span class="eyebrow">LOCAL FIELD GUIDE</span><h2>{district} <span>{guide.focus}</span></h2><p>{guide.check}</p><div class="local-guide-grid">{guide.examples.map((item,i)=><div class="local-guide-card"><b>{"0"+(i+1)}</b><h3>{item}</h3><p>{i===0?guide.tip:"폐기물 품목과 물량, 반출 동선을 사전에 확인해 주세요."}</p></div>)}</div><a class="btn btn-blue" href="/#quick-quote">현장 견적 준비하기 →</a></div><h2>{district} <span>동별 폐기물수거</span></h2><p>동네를 선택해 지역별 안내를 확인하세요.</p><div class="district-grid">{(neighborhoods[district]??[]).map(n=><a href={'/busan/'+encodeURIComponent(district)+'/'+encodeURIComponent(n)}>📍 {n}<span>↗</span></a>)}</div><h2>부산 <span>다른 지역</span></h2><div class="district-grid">{districts.filter(x=>x!==district).map(d=><a href={'/busan/'+encodeURIComponent(d)}>📍 {d}<span>↗</span></a>)}</div></div></section><section class="contact-section"><div class="wrap contact-inner"><div><h2>부산 {district} 폐기물 견적 문의</h2><p>현장 사진과 폐기물 종류를 알려주세요.</p></div><div class="contact-buttons"><a class="btn btn-white" href="tel:01066484886">📞 전화상담</a><a class="btn btn-yellow" href="http://qr.kakao.com/talk/xiB5oLU91AZmWwLV9g5AwwM4O5I-">💬 카카오톡 상담</a></div></div></section></main><Footer/></Base>
