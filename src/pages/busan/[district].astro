---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {districts,services} from '../../data/site';
import {neighborhoods} from '../../data/neighborhoods';
import {districtGuides} from '../../data/districtGuides';
export function getStaticPaths(){return districts.map(d=>({params:{district:d},props:{district:d}}));}
const {district}=Astro.props;
const guide=districtGuides[district];
const focus=guide.focus;
const localTitle=`부산 ${district} 폐기물수거 | ${guide.focus} 상담 - 부산폐기물`;
const localDescription=`부산 ${district} 폐기물 상담: ${guide.focus}. ${guide.check} ${guide.tip} 폐기물 종류·물량·반출 여건에 따라 가능 여부를 안내합니다.`;
const exampleNotes=[guide.tip,`현장 사진과 품목별 예상 물량을 구분해 보내주세요. ${guide.check}`,`출입구와 상차 장소의 사진을 보내주세요. ${guide.tip}`];
---
<Base breadcrumbs={[{name:'부산 '+district,path:'/busan/'+encodeURIComponent(district)}]} title={localTitle} description={localDescription}>
<Header/><main id="main-content" tabindex="-1" data-valid-services={JSON.stringify(services.map(s=>s.name))}><section class="sub-hero"><div class="wrap reveal in"><span class="eyebrow light">BUSAN · {district}</span><h1>부산 {district}<br/><em>폐기물수거 상담</em></h1><p>{focus} 폐기물부터 철거 잔재까지, 현장 상황을 확인해 수거 방법을 안내합니다.</p><div class="hero-ctas"><a class="btn btn-yellow" href="tel:01066484886">📞 전화 상담</a><a class="btn btn-white" href="http://qr.kakao.com/talk/xiB5oLU91AZmWwLV9g5AwwM4O5I-">💬 사진 견적 상담</a></div></div></section><section class="section"><div class="wrap"><div class="section-head"><span class="eyebrow">{district} WASTE SERVICES</span><h2>{district} 현장별 <span>폐기물 수거 안내</span></h2><p>폐기물의 종류와 현장 조건에 따라 반출 방식이 달라질 수 있습니다.</p></div><div class="service-grid regional-services">{services.map(s=><a class="service-card" href={'/services/'+s.slug}><span class="service-emoji"><img src={"/images/icons/"+s.slug+".svg"} width="90" height="90" loading="lazy" alt="" /></span><strong>{district} {s.name}</strong><small>{s.sub}</small><span class="service-arrow">↗</span></a>)}</div></div></section><section class="section about-section"><div class="wrap"><span class="eyebrow">LOCAL SERVICE GUIDE</span><h2>부산 {district} <span>수거 상담 시 확인사항</span></h2><p>현장 주소와 작업 층수, 엘리베이터 유무, 차량 접근 가능 여부, 폐기물 사진 및 예상 물량을 함께 알려주시면 보다 정확한 상담이 가능합니다. 건설폐기물과 사업장폐기물은 관련 법령에 따른 분류 및 처리 요건을 확인해야 합니다.</p><div class="local-guide"><span class="eyebrow">LOCAL FIELD GUIDE</span><h2>{district} <span>{guide.focus}</span></h2><p>{guide.check}</p><div class="local-guide-grid">{guide.examples.map((item,i)=><div class="local-guide-card"><b>{"0"+(i+1)}</b><h3>{item}</h3><p>{exampleNotes[i]}</p></div>)}</div><a class="btn btn-blue" data-service-quote href={'/?district='+encodeURIComponent(district)+'#quick-quote'}>현장 견적 준비하기 →</a></div><h2>{district} <span>동별 폐기물수거</span></h2><p>동네를 선택해 지역별 안내를 확인하세요.</p><div class="district-grid">{(neighborhoods[district]??[]).map(n=><a data-neighborhood-link href={'/busan/'+encodeURIComponent(district)+'/'+encodeURIComponent(n)}>📍 {n}<span>↗</span></a>)}</div><h2>부산 <span>다른 지역</span></h2><div class="district-grid">{districts.filter(x=>x!==district).map(d=><a data-other-district-link href={'/busan/'+encodeURIComponent(d)}>📍 {d}<span>↗</span></a>)}</div></div></section><section class="contact-section"><div class="wrap contact-inner"><div><h2>부산 {district} 폐기물 견적 문의</h2><p>현장 사진과 폐기물 종류를 알려주세요.</p></div><div class="contact-buttons"><a class="btn btn-white" href="tel:01066484886">📞 전화상담</a><a class="btn btn-yellow" href="http://qr.kakao.com/talk/xiB5oLU91AZmWwLV9g5AwwM4O5I-">💬 카카오톡 상담</a></div></div></section></main><Footer/><script is:inline>(()=>{const service=new URLSearchParams(location.search).get('service');const valid=JSON.parse(document.querySelector('#main-content')?.dataset.validServices||'[]');if(!valid.includes(service))return;document.querySelectorAll('[data-service-quote],[data-neighborhood-link],[data-other-district-link]').forEach(link=>{const url=new URL(link.href);url.searchParams.set('service',service);link.href=url.pathname+url.search+url.hash;});})();</script></Base>
