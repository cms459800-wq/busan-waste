---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {districts,services} from '../../data/site';
import {neighborhoods} from '../../data/neighborhoods';
import {districtGuides} from '../../data/districtGuides';
export function getStaticPaths(){return districts.map(d=>({params:{district:d},props:{district:d}}));}
const {district}=Astro.props;
const guide=districtGuides[district];
const focus=guide.focus;
const localTitle=`부산 ${district} 폐기물수거 | ${guide.focus} 현장 안내 - 부산폐기물`;
const localDescription=`부산 ${district} 폐기물수거 안내. ${guide.focus} 현장의 수거 품목·예상 물량·반출 동선·차량 접근 조건을 확인하고 사진 견적 상담을 준비하세요.`;
const exampleNotes=['현장 상황에 따라 수거 대상 품목과 분리할 물품을 먼저 확인해 주세요.','품목별 수량과 예상 부피를 구분해 사진으로 기록해 주세요.','출입구, 반출 경로와 차량 정차 가능 위치를 확인해 주세요.'];
---
<Base breadcrumbs={[{name:'부산 '+district,path:'/busan/'+encodeURIComponent(district)}]} title={localTitle} description={localDescription}>
<Header/><main id="main-content" tabindex="-1" data-valid-services={JSON.stringify(services.map(s=>s.name))}><section class="sub-hero"><div class="wrap reveal in"><span class="eyebrow light">BUSAN · {district}</span><h1>부산 {district}<br/><em>폐기물수거 상담</em></h1><p>{district}의 {focus} 관련 폐기물과 철거 잔재 수거를 상담합니다. 품목·물량·반출 조건을 확인해 현장에 맞는 방법을 안내합니다.</p><div class="hero-ctas"><a class="btn btn-yellow" href="tel:01066484886">📞 전화 상담</a><a class="btn btn-white" href="https://qr.kakao.com/talk/xiB5oLU91AZmWwLV9g5AwwM4O5I-" target="_blank" rel="noopener noreferrer">💬 사진 견적 상담</a><a class="btn btn-white" data-service-quote href={"/?district="+encodeURIComponent(district)+"#quick-quote"}>📋 상담 내용 미리 작성</a></div></div></section><section class="section"><div class="wrap"><div class="section-head"><span class="eyebrow">{district} WASTE SERVICES</span><h2>{district} 현장별 <span>폐기물 수거 안내</span></h2><p>폐기물의 종류와 현장 조건에 따라 반출 방식이 달라질 수 있습니다.</p></div><div class="service-grid regional-services">{services.map(s=><a class="service-card" href={'/services/'+s.slug+'?district='+encodeURIComponent(district)}><span class="service-emoji"><img src={"/images/icons/"+s.slug+".svg"} width="90" height="90" loading="lazy" alt="" /></span><strong>{district} {s.name}</strong><small>{s.sub}</small><span class="service-arrow">↗</span></a>)}</div></div></section><section class="section about-section"><div class="wrap"><span class="eyebrow">LOCAL SERVICE GUIDE</span><h2>부산 {district} <span>수거 상담 시 확인사항</span></h2><p>현장 주소와 작업 층수, 엘리베이터 유무, 차량 접근 가능 여부, 폐기물 사진 및 예상 물량을 함께 알려주시면 보다 정확한 상담이 가능합니다. 건설폐기물과 사업장폐기물은 관련 법령에 따른 분류 및 처리 요건을 확인해야 합니다.</p><div class="local-guide"><span class="eyebrow">LOCAL FIELD GUIDE</span><h2>{district} <span>{guide.focus}</span></h2><p>{guide.check}</p><div class="local-guide-grid">{guide.examples.map((item,i)=><div class="local-guide-card"><b>{"0"+(i+1)}</b><h3>{item}</h3><p>{exampleNotes[i]}</p></div>)}</div></div><h2>{district} <span>견적 문의 전 준비사항</span></h2><ol class="consultation-checklist"><li>폐기물 전체 사진과 주요 품목의 근접 사진을 준비해 주세요.</li><li>작업 층수와 엘리베이터 사용 가능 여부를 확인해 주세요.</li><li>차량 정차 위치 및 현장 입구 사진을 함께 알려주세요.</li><li>{guide.tip}</li></ol><a class="btn btn-blue" data-service-quote href={"/?district="+encodeURIComponent(district)+"#quick-quote"}>📋 {district} 현장 상담 내용 만들기</a><div class="local-quote-shortcut"><p><strong>📷 사진 상담 준비</strong> · 폐기물 전체·주요 품목·출입구 사진을 준비하면 상담에 도움이 됩니다.</p><a class="btn btn-blue" data-service-quote href={"/?district="+encodeURIComponent(district)+"#quick-quote"}>📋 {district} 현장 정보 미리 작성 →</a></div><h2>{district} <span>동별 폐기물수거</span></h2><p>부산 {district}의 동·읍·면을 선택해 해당 지역의 폐기물수거 안내를 확인하세요. 현장 위치와 수거 품목, 반출 조건에 따라 상담 준비사항을 살펴볼 수 있습니다.</p><nav class="district-grid" aria-label={district+' 동별 폐기물수거 지역 안내'}>{(neighborhoods[district]??[]).map(n=><a data-neighborhood-link href={'/busan/'+encodeURIComponent(district)+'/'+encodeURIComponent(n)} aria-label={'부산 '+district+' '+n+' 폐기물수거 안내 보기'}>📍 {n}<span aria-hidden="true">↗</span></a>)}</nav><h2>부산 <span>다른 지역</span></h2><p>현장이 다른 구·군에 있다면 해당 지역의 안내 페이지를 선택하세요. 지역별로 폐기물 종류와 반출 여건을 확인할 수 있습니다.</p><nav class="district-grid" aria-label="부산 다른 구·군 폐기물수거 안내">{districts.filter(x=>x!==district).map(d=><a data-other-district-link href={'/busan/'+encodeURIComponent(d)} aria-label={'부산 '+d+' 폐기물수거 안내 보기'}>📍 {d}<span aria-hidden="true">↗</span></a>)}</nav></div></section><section class="contact-section"><div class="wrap contact-inner"><div><h2>부산 {district} 폐기물 견적 문의</h2><p>폐기물 전체·주요 품목 사진과 작업 층수, 차량 진입 가능 여부를 알려주시면 상담에 도움이 됩니다.</p></div><div class="contact-buttons"><a class="btn btn-white" href="tel:01066484886">📞 전화상담</a><a class="btn btn-yellow" href="https://qr.kakao.com/talk/xiB5oLU91AZmWwLV9g5AwwM4O5I-" target="_blank" rel="noopener noreferrer">💬 카카오톡 상담</a><a class="btn btn-white" data-service-quote href={"/?district="+encodeURIComponent(district)+"#quick-quote"}>📋 {district} 상담 내용 작성</a></div></div></section></main><Footer/><script is:inline>(()=>{const params=new URLSearchParams(location.search);let valid=[];try{valid=JSON.parse(document.querySelector('#main-content')?.dataset.validServices||'[]')}catch{return}const service=params.get('service');const amount=params.get('amount');const access=params.get('access');const allowedAmount=['소량 (1톤 미만 추정)','1톤 차량 1대 내외 추정','다량 (차량 여러 대 예상)','현장 확인 필요'];const allowedAccess=['1층 / 차량 접근 가능','엘리베이터 이용 가능','계단 운반 필요','장비 진입 여부 확인 필요'];const selections={};if(service&&valid.includes(service))selections.service=service;if(amount&&allowedAmount.includes(amount))selections.amount=amount;if(access&&allowedAccess.includes(access))selections.access=access;if(!Object.keys(selections).length)return;document.querySelectorAll('[data-service-quote],[data-neighborhood-link],[data-other-district-link]').forEach(link=>{const url=new URL(link.href);for(const [key,value] of Object.entries(selections))url.searchParams.set(key,value);link.href=url.pathname+url.search+url.hash;});})();</script></Base>
