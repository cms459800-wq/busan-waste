---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import {neighborhoods} from '../../../data/neighborhoods';
import {services} from '../../../data/site';
export function getStaticPaths(){return Object.entries(neighborhoods).flatMap(([district,names])=>names.map(name=>({params:{district,name},props:{district,name}})));}
const {district,name}=Astro.props;
const focus=district==='강서구'?'창고·사업장':district==='사상구'?'공장·상가':district==='부산진구'?'상가·인테리어':district==='해운대구'?'리모델링·상가':'건설·인테리어';
---
<Base title={name+'폐기물수거 | 부산 '+district+' 건설·인테리어폐기물 상담 - 부산폐기물'} description={'부산 '+district+' '+name+' 폐기물수거 상담. '+focus+' 폐기물, 철거 잔재물, 폐목재, 혼합폐기물 등 현장 품목과 물량, 반출 조건에 따라 수거 가능 여부를 안내합니다.'}><Header/><main><section class="sub-hero"><div class="wrap"><span class="eyebrow light">BUSAN · {district} · {name}</span><h1>{name} <em>폐기물수거</em></h1><p>부산 {district} {name} 건설·인테리어·철거 폐기물 현장 상담. 폐기물 사진과 반출 조건을 알려주시면 작업 가능 여부를 안내합니다.</p><div class="hero-ctas"><a class="btn btn-yellow" href="tel:01066484886">📞 전화 상담</a><a class="btn btn-white" href="http://qr.kakao.com/talk/xiB5oLU91AZmWwLV9g5AwwM4O5I-">💬 카카오톡 상담</a></div></div></section><section class="section"><div class="wrap"><div class="section-head"><span class="eyebrow">LOCAL WASTE GUIDE</span><h2>{name} <span>폐기물 종류별 상담</span></h2><p>철거·공사·상가 정리 등 작업 목적에 따라 필요한 수거 방식이 다릅니다.</p></div><div class="service-grid regional-services">{services.map(s=><a class="service-card" href={'/services/'+s.slug}><span class="service-emoji"><img src={"/images/icons/"+s.slug+".svg"} width="90" height="90" loading="lazy" alt="" /></span><strong>{s.name}</strong><small>{s.sub}</small><span class="service-arrow">↗</span></a>)}</div></div></section><section class="section about-section"><div class="wrap"><span class="eyebrow">BEFORE REQUESTING A QUOTE</span><h2>{name} 현장 <span>견적 체크리스트</span></h2><div class="info-steps"><div><b>01</b><h3>폐기물 사진과 품목</h3><p>석고보드, 폐목재, 철거 잔재 등 물품 종류와 혼합 여부를 알려주세요.</p></div><div><b>02</b><h3>반출 조건</h3><p>층수, 엘리베이터, 차량 진입로 및 주차 여건을 확인합니다.</p></div><div><b>03</b><h3>수거 범위·일정</h3><p>폐기물 분류 및 적법한 처리 가능 여부를 확인한 뒤 안내합니다.</p></div></div><p style="margin-top:24px"><a class="btn btn-outline" href={'/busan/'+encodeURIComponent(district)}>← {district} 전체 지역 안내</a></p></div></section></main><Footer/></Base>
