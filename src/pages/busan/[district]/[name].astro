---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import {neighborhoods} from '../../../data/neighborhoods';
import {services} from '../../../data/site';
import {districtGuides} from '../../../data/districtGuides';
export function getStaticPaths(){return Object.entries(neighborhoods).flatMap(([district,names])=>names.map(name=>({params:{district,name},props:{district,name}})));}
const {district,name}=Astro.props;
const guide=districtGuides[district];
const nearby=(neighborhoods[district]??[]).filter(n=>n!==name);
const neighborhoodIndex=(neighborhoods[district]??[]).indexOf(name);
const topic=guide.examples[Math.max(0,neighborhoodIndex)%guide.examples.length];
const fieldQuestions=[{q:`${name} 현장 사진은 무엇을 보내야 하나요?`,a:`${district} ${name} 현장의 폐기물 전체 모습, 품목별 근접 사진, 출입구와 차량 접근로 사진을 보내주시면 상담에 도움이 됩니다.`},{q:`${name}에서 차량 진입이 어려우면 어떻게 하나요?`,a:`${guide.check} 현장 층수와 이동 거리, 주차 위치를 알려주시면 반출 방식의 가능 여부를 확인합니다.`},{q:`${name} 폐기물 견적은 어떤 조건에 따라 달라지나요?`,a:'폐기물 종류와 물량, 분리 상태, 운반 거리, 층수와 장비 투입 여부에 따라 달라질 수 있습니다. 사진 상담은 확정 견적이 아닙니다.'}];
const localTitle=`${name}폐기물수거 | 부산 ${district} ${topic} 상담 - 부산폐기물`;
const itemTips=[`품목과 혼합 상태를 사진으로 구분해 주세요. ${guide.check}`,`반출 시간과 이동 동선을 확인해 주세요. ${guide.tip}`,`예상 물량과 장비 진입 조건을 확인해 주세요. ${guide.check}`];
const localDescription=`부산 ${district} ${name}폐기물수거 상담. ${topic} 관련 현장은 ${itemTips[neighborhoodIndex%3] ?? guide.check} 폐기물 종류·물량·반출 여건에 따라 가능 여부를 안내합니다.`;

---
<Base breadcrumbs={[{name:'부산 '+district,path:'/busan/'+encodeURIComponent(district)},{name:name,path:'/busan/'+encodeURIComponent(district)+'/'+encodeURIComponent(name)}]} title={localTitle} description={localDescription}><Header/><main id="main-content" tabindex="-1" data-valid-services={JSON.stringify(services.map(s=>s.name))}><section class="sub-hero"><div class="wrap"><span class="eyebrow light">BUSAN · {district} · {name}</span><h1>{name} <em>폐기물수거</em></h1><p>부산 {district} {name} 건설·인테리어·철거 폐기물 현장 상담. 폐기물 사진과 반출 조건을 알려주시면 작업 가능 여부를 안내합니다.</p><div class="hero-ctas"><a class="btn btn-yellow" href="tel:01066484886">📞 전화 상담</a><a class="btn btn-white" href="https://qr.kakao.com/talk/xiB5oLU91AZmWwLV9g5AwwM4O5I-" target="_blank" rel="noopener noreferrer">💬 카카오톡 상담</a><a class="btn btn-white" data-service-quote href={"/?district="+encodeURIComponent(district)+"&neighborhood="+encodeURIComponent(name)+"#quick-quote"}>📋 현장 상담 내용 작성</a></div></div></section><section class="section"><div class="wrap"><div class="section-head"><span class="eyebrow">LOCAL WASTE GUIDE</span><h2>{name} <span>폐기물 종류별 상담</span></h2><p>철거·공사·상가 정리 등 작업 목적에 따라 필요한 수거 방식이 다릅니다.</p></div><div class="service-grid regional-services">{services.map(s=><a class="service-card" href={'/services/'+s.slug+'?district='+encodeURIComponent(district)+'&neighborhood='+encodeURIComponent(name)}><span class="service-emoji"><img src={"/images/icons/"+s.slug+".svg"} width="90" height="90" loading="lazy" alt="" /></span><strong>{s.name}</strong><small>{s.sub}</small><span class="service-arrow">↗</span></a>)}</div></div></section><section class="section about-section"><div class="wrap"><span class="eyebrow">BEFORE REQUESTING A QUOTE</span><h2>{name} 현장 <span>견적 체크리스트</span></h2><div class="local-guide"><span class="eyebrow">NEIGHBORHOOD FIELD GUIDE</span><h2>{name} 현장 안내 · <span>{topic}</span></h2><p>부산 {district} {name}에서 {topic} 관련 수거를 문의할 때는 폐기물의 품목과 발생 경위, 반출 가능 시간을 구체적으로 알려주세요. 실제 작업 가능 여부는 현장 확인과 법적 처리 요건에 따라 달라집니다.</p><p>{guide.check}</p><p>{guide.tip}</p><div class="local-guide-grid">{guide.examples.map((item,i)=><div class="local-guide-card"><h3>{item}</h3><p>{itemTips[i]}</p></div>)}</div><a class="btn btn-blue" data-service-quote href={'/?district='+encodeURIComponent(district)+'&neighborhood='+encodeURIComponent(name)+'#quick-quote'}>견적 준비하기 →</a></div><div class="info-steps"><div><b>01</b><h3>폐기물 사진과 품목</h3><p>석고보드, 폐목재, 철거 잔재 등 물품 종류와 혼합 여부를 알려주세요.</p></div><div><b>02</b><h3>반출 조건</h3><p>층수, 엘리베이터, 차량 진입로 및 주차 여건을 확인합니다.</p></div><div><b>03</b><h3>수거 범위·일정</h3><p>폐기물 분류 및 적법한 처리 가능 여부를 확인한 뒤 안내합니다.</p></div></div><div class="neighborhood-extra"><h2>{name} 폐기물 상담 <span>자주 묻는 질문</span></h2><div class="faq-list">{fieldQuestions.map(item=><details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div><h2>{district} <span>인근 지역 안내</span></h2><nav class="district-grid" aria-label={district+" 인근 동·읍·면 폐기물수거 안내"}>{nearby.map(n=><a data-nearby-link href={"/busan/"+encodeURIComponent(district)+"/"+encodeURIComponent(n)} aria-label={"부산 "+district+" "+n+" 폐기물수거 안내 보기"}>📍 {n} 폐기물 <span aria-hidden="true">↗</span></a>)}</nav></div><p style="margin-top:24px"><a class="btn btn-outline" data-back-link href={'/busan/'+encodeURIComponent(district)}>← {district} 전체 지역 안내</a></p></div></section></main><Footer/><script is:inline>(()=>{const service=new URLSearchParams(location.search).get('service');let valid=[];try{valid=JSON.parse(document.querySelector('#main-content')?.dataset.validServices||'[]')}catch{return}if(!valid.includes(service))return;document.querySelectorAll('[data-service-quote],[data-nearby-link],[data-back-link]').forEach(link=>{const url=new URL(link.href);url.searchParams.set('service',service);link.href=url.pathname+url.search+url.hash;});})();</script></Base>
