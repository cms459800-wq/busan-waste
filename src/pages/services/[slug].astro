---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {services,districts} from '../../data/site';
import {serviceGuides} from '../../data/serviceGuides';
import {neighborhoods} from '../../data/neighborhoods';
export function getStaticPaths(){return services.map(s=>({params:{slug:s.slug},props:{service:s}}));}
const {service}=Astro.props;
const guide=serviceGuides[service.slug];
const materialNotes=[`현장에 ${guide.materials[0]}이 포함되어 있다면 종류와 예상 물량을 확인해 주세요.`,`다른 폐기물과 섞여 있는지 사진으로 구분해 알려주세요.`,`상차 장소와 차량 진입 조건에 따라 반출 방식이 달라질 수 있습니다.`];
---
<Base breadcrumbs={[{name:'부산 '+service.name,path:'/services/'+service.slug}]} title={'부산 '+service.name+' 수거·처리 상담 | 부산폐기물'} description={'부산 '+service.name+' 상담. '+service.desc+' 부산 16개 구·군 현장별 폐기물 수거 견적 문의.'}><Header/><main id="main-content" tabindex="-1" data-districts={JSON.stringify(districts)} data-neighborhoods={JSON.stringify(neighborhoods)}><section class="sub-hero"><div class="wrap"><span class="eyebrow light">BUSAN WASTE SERVICE</span><h1>{service.icon} 부산 <em>{service.name}</em></h1><p>{service.desc}</p><div class="hero-ctas"><a class="btn btn-yellow" href="tel:01066484886">📞 전화 상담</a><a class="btn btn-white" href="http://qr.kakao.com/talk/xiB5oLU91AZmWwLV9g5AwwM4O5I-">💬 사진 견적 상담</a></div></div></section><section class="section"><div class="wrap"><div class="section-head"><span class="eyebrow">SERVICE GUIDE</span><h2>현장에 맞는 <span>수거 상담</span></h2><p>{service.sub}</p></div><div class="info-steps"><div><b>01</b><h3>현장 정보 접수</h3><p>구·동, 폐기물 사진과 종류를 확인합니다.</p></div><div><b>02</b><h3>물량·반출 여건 확인</h3><p>층수, 차량 진입, 장비 필요 여부를 확인합니다.</p></div><div><b>03</b><h3>작업 가능 여부 안내</h3><p>품목별 법적 처리 요건을 확인해 안내합니다.</p></div></div></div></section><section class="section about-section"><div class="wrap local-guide"><h2>{guide.headline}</h2><div class="local-guide-grid">{guide.materials.map((item,i)=><div class="local-guide-card"><b>{i+1}</b><h3>{item}</h3><p>{materialNotes[i]}</p></div>)}</div><p>{guide.tip}</p><p>{guide.caution}</p><a class="btn btn-blue" data-service-quote href={'/?service='+encodeURIComponent(service.name)+'#quick-quote'}>견적 준비하기 →</a></div><div class="wrap"><h2>부산 <span>지역별 {service.name}</span></h2><div class="district-grid">{districts.map(d=><a data-district-link={d} href={'/busan/'+encodeURIComponent(d)+'?service='+encodeURIComponent(service.name)}>📍 {d}<span>↗</span></a>)}</div></div></section></main><Footer/><script is:inline>(()=>{const selected=new URLSearchParams(location.search).get("district");let districts=[];try{districts=JSON.parse(document.querySelector("#main-content")?.dataset.districts||"[]")}catch{return}if(!districts.includes(selected))return;const neighborhood=new URLSearchParams(location.search).get("neighborhood");let neighborhoods={};try{neighborhoods=JSON.parse(document.querySelector("#main-content")?.dataset.neighborhoods||"{}")}catch{}const validNeighborhood=Array.isArray(neighborhoods[selected])&&neighborhoods[selected].includes(neighborhood);document.querySelectorAll("[data-service-quote]").forEach(link=>{const url=new URL(link.href);url.searchParams.set("district",selected);if(validNeighborhood)url.searchParams.set("neighborhood",neighborhood);link.href=url.pathname+url.search+url.hash});document.querySelectorAll("[data-district-link]").forEach(link=>{if(link.dataset.districtLink===selected){link.setAttribute("aria-current","location");link.prepend("선택 지역 · ")}})})();</script></Base>
