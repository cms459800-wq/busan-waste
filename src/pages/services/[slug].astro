---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {services,districts} from '../../data/site';
import {serviceGuides} from '../../data/serviceGuides';
import {neighborhoods} from '../../data/neighborhoods';
export function getStaticPaths(){return services.map(s=>({params:{slug:s.slug},props:{service:s}}));}
const {service}=Astro.props;
const guide=serviceGuides[service.slug];
const materialNotes=[`현장에 ${guide.materials[0]}이 포함되어 있다면 종류와 예상 물량을 확인해 주세요.`,`다른 폐기물과 섞여 있는지 사진으로 구분해 알려주세요.`,`상차 장소와 차량 진입 조건에 따라 반출 방식이 달라질 수 있습니다.`];
---
<Base breadcrumbs={[{name:'부산 '+service.name,path:'/services/'+service.slug}]} title={'부산 '+service.name+' 수거·처리 상담 | 부산폐기물'} description={'부산 '+service.name+' 상담. '+service.desc+' 부산 16개 구·군 현장별 폐기물 수거 견적 문의.'}><Header/><main id="main-content" tabindex="-1" data-districts={JSON.stringify(districts)} data-neighborhoods={JSON.stringify(neighborhoods)}><section class="sub-hero"><div class="wrap"><span class="eyebrow light">BUSAN WASTE SERVICE</span><h1>{service.icon} 부산 <em>{service.name}</em></h1><p>{service.desc}</p><div class="hero-ctas"><a class="btn btn-yellow" href="tel:01066484886">📞 전화 상담</a><a class="btn btn-white" href="https://qr.kakao.com/talk/xiB5oLU91AZmWwLV9g5AwwM4O5I-" target="_blank" rel="noopener noreferrer">💬 사진 견적 상담</a><a class="btn btn-white" data-service-quote href={"/?service="+encodeURIComponent(service.name)+"#quick-quote"}>📋 상담 내용 먼저 작성</a></div></div></section><section class="section"><div class="wrap"><div class="section-head"><span class="eyebrow">SERVICE GUIDE</span><h2>현장에 맞는 <span>수거 상담</span></h2><p>{service.sub}</p></div><div class="info-steps"><div><b>01</b><h3>현장 정보 접수</h3><p>구·동, 폐기물 사진과 종류를 확인합니다.</p></div><div><b>02</b><h3>물량·반출 여건 확인</h3><p>층수, 차량 진입, 장비 필요 여부를 확인합니다.</p></div><div><b>03</b><h3>작업 가능 여부 안내</h3><p>품목별 법적 처리 요건을 확인해 안내합니다.</p></div></div></div></section><section class="section about-section"><div class="wrap local-guide"><h2>{guide.headline}</h2><div class="local-guide-grid">{guide.materials.map((item,i)=><div class="local-guide-card"><b>{i+1}</b><h3>{item}</h3><p>{materialNotes[i]}</p></div>)}</div><p>{guide.tip}</p><p>{guide.caution}</p><aside class="service-local-context" id="service-local-context" hidden><strong id="service-local-title">선택한 지역의 상담 정보</strong><p id="service-local-description"></p><a class="service-local-back" id="service-local-back" href="/busan">지역 안내로 돌아가기 →</a></aside><a class="btn btn-blue" data-service-quote href={'/?service='+encodeURIComponent(service.name)+'#quick-quote'}>📋 {service.name} 견적 상담 작성 →</a></div><div class="wrap"><h2>부산 <span>지역별 {service.name}</span></h2><div class="district-grid">{districts.map(d=><a data-district-link={d} href={'/busan/'+encodeURIComponent(d)+'?service='+encodeURIComponent(service.name)}>📍 {d}<span>↗</span></a>)}</div></div></section></main><Footer/><script is:inline>(()=>{const selected=new URLSearchParams(location.search).get("district");let districts=[];try{districts=JSON.parse(document.querySelector("#main-content")?.dataset.districts||"[]")}catch{return}if(!districts.includes(selected))return;const neighborhood=new URLSearchParams(location.search).get("neighborhood");let neighborhoods={};try{neighborhoods=JSON.parse(document.querySelector("#main-content")?.dataset.neighborhoods||"{}")}catch{}const validNeighborhood=Array.isArray(neighborhoods[selected])&&neighborhoods[selected].includes(neighborhood);const context=document.querySelector("#service-local-context");const title=document.querySelector("#service-local-title");const description=document.querySelector("#service-local-description");const back=document.querySelector("#service-local-back");if(context&&title&&description&&back){context.hidden=false;title.textContent="부산 "+selected+(validNeighborhood?" "+neighborhood:"")+" 현장 상담";description.textContent="선택한 지역 정보를 유지한 채 폐기물 종류와 반출 조건을 입력할 수 있습니다. 현장 사진은 카카오톡에서 별도로 첨부해 주세요.";back.href="/busan/"+encodeURIComponent(selected)+(validNeighborhood?"/"+encodeURIComponent(neighborhood):"");}document.querySelectorAll("[data-service-quote]").forEach(link=>{const url=new URL(link.href);url.searchParams.set("district",selected);if(validNeighborhood)url.searchParams.set("neighborhood",neighborhood);link.href=url.pathname+url.search+url.hash});document.querySelectorAll("[data-district-link]").forEach(link=>{if(link.dataset.districtLink===selected){link.setAttribute("aria-current","location");link.prepend("선택 지역 · ");if(validNeighborhood){const url=new URL(link.href);url.pathname="/busan/"+encodeURIComponent(selected)+"/"+encodeURIComponent(neighborhood);link.href=url.pathname+url.search+url.hash;link.setAttribute("aria-label","부산 "+selected+" "+neighborhood+" 현장 안내로 돌아가기");}}})})();</script><style>.service-local-context{margin:18px 0;padding:18px 20px;border:1px solid #bfdbfe;border-radius:14px;background:#eff6ff;color:#1e3a8a}.service-local-context[hidden]{display:none}.service-local-context strong{display:block;font-weight:800}.service-local-context p{margin:8px 0;line-height:1.7;color:#334155}.service-local-back{display:inline-flex;align-items:center;min-height:44px;font-weight:700;color:#1d4ed8;text-decoration:underline;text-underline-offset:3px}.service-local-back:focus-visible{outline:3px solid #60a5fa;outline-offset:3px}@media(max-width:640px){.service-local-context{padding:14px}}.sub-hero .hero-ctas a{min-height:46px;justify-content:center;text-align:center}.service-local-context + .btn{min-height:48px}@media(max-width:640px){.sub-hero .hero-ctas{display:grid;grid-template-columns:1fr 1fr;gap:10px}.sub-hero .hero-ctas a{min-width:0;min-height:50px;padding:12px 10px;line-height:1.4;font-size:.94rem}.sub-hero .hero-ctas a:last-child{grid-column:1/-1}.service-local-context + .btn{display:flex;width:100%;justify-content:center;text-align:center}}@media(max-width:360px){.sub-hero .hero-ctas{grid-template-columns:1fr}.sub-hero .hero-ctas a:last-child{grid-column:auto}}</style></Base>
