---
import {districts,services} from '../data/site';
import {neighborhoods} from '../data/neighborhoods';
---
<section class="section quick-quote-section" id="quick-quote"><div class="wrap quote-layout"><div class="quote-intro reveal"><span class="eyebrow">QUICK ESTIMATE</span><h2>사진 견적 전에<br/><span>현장 정보를 정리해보세요</span></h2><p>폐기물 종류와 지역, 반출 조건을 선택하면 상담에 필요한 내용을 자동으로 정리합니다. 작성 내용은 서버에 저장하지 않습니다.</p><div class="quote-benefits"><span>📍 부산 지역 선택</span><span>🏗️ 폐기물 종류 선택</span><span>📋 상담 내용 자동 정리</span></div></div><form class="quote-form reveal" id="quote-builder" data-neighborhoods={JSON.stringify(neighborhoods)}><div class="quote-form-head"><strong>무료 상담 준비</strong><small>약 30초 · 개인정보 입력 불필요</small></div><div class="quote-form-grid"><label>현장 지역<select name="district" required><option value="">구·군 선택</option>{districts.map(d=><option value={d}>{d}</option>)}</select></label><label>현장 동·읍·면 (선택)<select name="neighborhood" aria-describedby="quote-neighborhood-help" disabled><option value="">구·군을 먼저 선택</option></select><small id="quote-neighborhood-help">구·군 선택 후 해당 동네를 고를 수 있습니다.</small></label><label>폐기물 종류<select name="service" required><option value="">종류 선택</option>{services.map(s=><option value={s.name}>{s.name}</option>)}</select></label><label>예상 물량<select name="amount" required><option value="">물량 선택</option><option>소량 (1톤 미만 추정)</option><option>1톤 차량 1대 내외 추정</option><option>다량 (차량 여러 대 예상)</option><option>현장 확인 필요</option></select></label><label>반출 조건<select name="access" required><option value="">반출 조건 선택</option><option>1층 / 차량 접근 가능</option><option>엘리베이터 이용 가능</option><option>계단 운반 필요</option><option>장비 진입 여부 확인 필요</option></select></label></div><label class="quote-notes">추가 현장 정보 (선택)<textarea name="notes" rows="3" maxlength="300" placeholder="예: 부산진구 전포동, 인테리어 철거 후 폐목재·석고보드 등"></textarea></label><button type="submit" class="btn btn-blue quote-submit" aria-controls="quote-result">📋 상담 내용 만들기</button><div class="quote-result" id="quote-result" role="region" aria-label="생성된 상담 내용" hidden><strong>상담 내용이 준비됐습니다.</strong><pre id="quote-preview" tabindex="0"></pre><div class="quote-actions"><button type="button" class="btn btn-outline" id="quote-copy">내용 복사</button><a class="btn btn-yellow" href="http://qr.kakao.com/talk/xiB5oLU91AZmWwLV9g5AwwM4O5I-" target="_blank" rel="noopener noreferrer">💬 카카오톡 열기</a></div><small>① 내용 복사 → ② 카카오톡 열기 → ③ 채팅창에 붙여넣기 → ④ 폐기물 전체·주요 품목·반출 동선 사진 첨부. 상담 내용과 사진은 자동 전송되지 않습니다.</small><p id="quote-feedback" role="status" aria-live="polite"></p></div></form></div></section>
<script is:inline>
(()=>{const form=document.querySelector('#quote-builder');const result=document.querySelector('#quote-result');const preview=document.querySelector('#quote-preview');const feedback=document.querySelector('#quote-feedback');const params=new URLSearchParams(location.search);const selectedDistrict=params.get('district');const selectedService=params.get('service');let local={};try{local=JSON.parse(form?.dataset.neighborhoods||'{}')}catch{}const neighborhoodSelect=form?.elements.neighborhood;const updateNeighborhood=()=>{if(!neighborhoodSelect||!form)return;const district=form.elements.district.value;const items=Array.isArray(local[district])?local[district]:[];const previous=neighborhoodSelect.value;const help=document.querySelector('#quote-neighborhood-help');if(help)help.textContent=items.length?district+'의 동·읍·면을 선택할 수 있습니다.':'구·군 선택 후 해당 동네를 고를 수 있습니다.';neighborhoodSelect.replaceChildren(new Option(items.length?'동·읍·면 선택':'구·군을 먼저 선택',''));for(const item of items)neighborhoodSelect.add(new Option(item,item));neighborhoodSelect.disabled=!items.length;if(items.includes(previous))neighborhoodSelect.value=previous;else neighborhoodSelect.value='';};if(form){if(selectedDistrict&&Array.from(form.elements.district.options).some(o=>o.value===selectedDistrict))form.elements.district.value=selectedDistrict;if(selectedService&&Array.from(form.elements.service.options).some(o=>o.value===selectedService))form.elements.service.value=selectedService;updateNeighborhood();const requested=params.get('neighborhood');if(neighborhoodSelect&&requested&&Array.isArray(local[form.elements.district.value])&&local[form.elements.district.value].includes(requested))neighborhoodSelect.value=requested;form.elements.district.addEventListener('change',()=>{if(neighborhoodSelect)neighborhoodSelect.value='';updateNeighborhood()});}let message='';const resetResult=()=>{if(result&&!result.hidden){result.hidden=true;if(feedback)feedback.textContent='';message='';}};form?.addEventListener('input',resetResult);form?.addEventListener('change',resetResult);form?.addEventListener('submit',e=>{e.preventDefault();if(!form.reportValidity())return;const d=new FormData(form);message=['[부산폐기물 수거 상담]','현장 지역: 부산 '+d.get('district')+(d.get('neighborhood')?' '+d.get('neighborhood'):''),'폐기물 종류: '+d.get('service'),'예상 물량: '+d.get('amount'),'반출 조건: '+d.get('access'),d.get('notes')?'추가 정보: '+d.get('notes'):'','현장 사진: 폐기물 전체 모습·주요 품목·반출 동선 사진을 별도 전송 예정','상담 참고: 현장 주소와 차량 정차 가능 위치도 함께 알려주세요.'].filter(Boolean).join('\n');preview.textContent=message;result.hidden=false;feedback.textContent='';result.scrollIntoView({behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'nearest'});preview.focus({preventScroll:true})});document.querySelector('#quote-copy')?.addEventListener('click',async()=>{const copiedMessage=message;try{if(!copiedMessage||result?.hidden)throw new Error('empty');if(navigator.clipboard?.writeText){await navigator.clipboard.writeText(copiedMessage)}else{const range=document.createRange();range.selectNodeContents(preview);const selection=window.getSelection();selection.removeAllRanges();selection.addRange(range);if(!document.execCommand('copy'))throw new Error('copy failed');selection.removeAllRanges()}if(message===copiedMessage&&!result.hidden)feedback.textContent='상담 내용을 복사했습니다. 카카오톡에 붙여넣어 주세요.'}catch{if(!copiedMessage||message!==copiedMessage||result.hidden)return;try{const range=document.createRange();range.selectNodeContents(preview);const selection=window.getSelection();if(!selection)throw new Error('selection unavailable');selection.removeAllRanges();selection.addRange(range);preview.focus({preventScroll:true});feedback.textContent='자동 복사가 지원되지 않습니다. 선택된 내용을 직접 복사해 주세요.'}catch{feedback.textContent='자동 복사를 사용할 수 없습니다. 위 상담 내용을 길게 눌러 직접 복사해 주세요.'}}})})();
</script>
