---
import {districts,services} from '../data/site';
---
<section class="section quick-quote-section" id="quick-quote"><div class="wrap quote-layout"><div class="quote-intro reveal"><span class="eyebrow">QUICK ESTIMATE</span><h2>사진 견적 전에<br/><span>현장 정보를 정리해보세요</span></h2><p>폐기물 종류와 지역, 반출 조건을 선택하면 상담에 필요한 내용을 자동으로 정리합니다. 작성 내용은 서버에 저장하지 않습니다.</p><div class="quote-benefits"><span>📍 부산 지역 선택</span><span>🏗️ 폐기물 종류 선택</span><span>📋 상담 내용 자동 정리</span></div></div><form class="quote-form reveal" id="quote-builder"><div class="quote-form-head"><strong>무료 상담 준비</strong><small>약 30초 · 개인정보 입력 불필요</small></div><div class="quote-form-grid"><label>현장 지역<select name="district" required><option value="">구·군 선택</option>{districts.map(d=><option value={d}>{d}</option>)}</select></label><label>폐기물 종류<select name="service" required><option value="">종류 선택</option>{services.map(s=><option value={s.name}>{s.name}</option>)}</select></label><label>예상 물량<select name="amount" required><option value="">물량 선택</option><option>소량 (1톤 미만 추정)</option><option>1톤 차량 1대 내외 추정</option><option>다량 (차량 여러 대 예상)</option><option>현장 확인 필요</option></select></label><label>반출 조건<select name="access" required><option value="">반출 조건 선택</option><option>1층 / 차량 접근 가능</option><option>엘리베이터 이용 가능</option><option>계단 운반 필요</option><option>장비 진입 여부 확인 필요</option></select></label></div><label class="quote-notes">추가 현장 정보 (선택)<textarea name="notes" rows="3" maxlength="300" placeholder="예: 부산진구 전포동, 인테리어 철거 후 폐목재·석고보드 등"></textarea></label><button type="submit" class="btn btn-blue quote-submit">📋 상담 내용 만들기</button><div class="quote-result" id="quote-result" hidden><strong>상담 내용이 준비됐습니다.</strong><pre id="quote-preview"></pre><div class="quote-actions"><button type="button" class="btn btn-outline" id="quote-copy">내용 복사</button><a class="btn btn-yellow" href="http://qr.kakao.com/talk/xiB5oLU91AZmWwLV9g5AwwM4O5I-" target="_blank" rel="noopener noreferrer">💬 카카오톡 열기</a></div><small>복사한 내용을 카카오톡 채팅창에 붙여넣고 현장 사진을 함께 보내주세요. 자동 전송되지는 않습니다.</small><p id="quote-feedback" role="status" aria-live="polite"></p></div></form></div></section>
<script is:inline>
(()=>{const form=document.querySelector('#quote-builder');const result=document.querySelector('#quote-result');const preview=document.querySelector('#quote-preview');const feedback=document.querySelector('#quote-feedback');const params=new URLSearchParams(location.search);const selectedDistrict=params.get('district');const selectedService=params.get('service');if(form){if(selectedDistrict&&Array.from(form.elements.district.options).some(o=>o.value===selectedDistrict))form.elements.district.value=selectedDistrict;if(selectedService&&Array.from(form.elements.service.options).some(o=>o.value===selectedService))form.elements.service.value=selectedService;const neighborhood=params.get('neighborhood');if(neighborhood&&neighborhood.length<=40&&/^[가-힣0-9\s-]+$/.test(neighborhood)){form.elements.notes.value='현장 위치: '+neighborhood+'\n';}}let message='';form?.addEventListener('input',()=>{if(!result.hidden){result.hidden=true;feedback.textContent='';message='';}});form?.addEventListener('change',()=>{if(!result.hidden){result.hidden=true;feedback.textContent='';message='';}});form?.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(form);message=['[부산폐기물 수거 상담]','현장 지역: 부산 '+d.get('district'),'폐기물 종류: '+d.get('service'),'예상 물량: '+d.get('amount'),'반출 조건: '+d.get('access'),d.get('notes')?'추가 정보: '+d.get('notes'):'','현장 사진은 별도 전송 예정'].filter(Boolean).join('\n');preview.textContent=message;result.hidden=false;feedback.textContent='';result.scrollIntoView({behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'nearest'})});document.querySelector('#quote-copy')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(message);feedback.textContent='상담 내용을 복사했습니다. 카카오톡에 붙여넣어 주세요.'}catch{feedback.textContent='복사할 수 없습니다. 위 내용을 직접 선택해 복사해 주세요.'}})})();
</script>
